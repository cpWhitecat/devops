# GitHub Runner 环境变量配置
# 复制此文件为 .env 并填入实际值

# GitHub 仓库信息
GITHUB_URL=https://github.com/cpWhitecat/devops

# GitHub Personal Access Token (从 Settings → Developer settings → Personal access tokens 获取)
# 需要权限: repo, workflow, admin:org_hook
GITHUB_TOKEN=your_github_token_here

# Runner 配置
RUNNER_NAME=centos-runner-01
RUNNER_GROUP=Default
RUNNER_LABELS=linux,docker,sqlmap

# 工作目录
RUNNER_WORKDIR=/tmp/runner-work

# Docker 相关配置
DOCKER_NETWORK=bridge  # bridge 或 host

# 可选：扫描目标（供 workflows 使用）
SCAN_TARGET=http://your-target.com

# 可选：Docker Registry 凭证（如需推送镜像）
# DOCKER_USERNAME=
# DOCKER_PASSWORD=
# DOCKER_REGISTRY=
